# Locally: true shows interactive demo without external services.
# Production: MUST be false; no role switching / anonymous access in live mode.
NEXT_PUBLIC_DEMO_MODE=true
# Supabase Dashboard -> Connect -> Transaction pooler (port 6543) for Vercel.
# Copy the exact hostname/username supplied by Supabase. NEVER prefix NEXT_PUBLIC_.
DATABASE_URL=postgresql://postgres.PROJECT:CHANGE_ME@YOUR-SUPABASE-POOLER-HOST:6543/postgres
TELEGRAM_BOT_TOKEN=CHANGE_ME
# 32+ random bytes; e.g. openssl rand -hex 32
SESSION_SECRET=CHANGE_ME
# Your Telegram ID(s), comma-separated. First sign-in bootstraps a coach workspace.
BOOTSTRAP_COACH_TELEGRAM_IDS=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MINI_APP_SHORT_NAME=
# Optional in live Telegram mode, because invitation links use bot username + app short name.
NEXT_PUBLIC_APP_URL=

# Private video moderation: Supabase Project Settings -> API
# SECRET: server-only. Never use NEXT_PUBLIC_ prefix or commit your real key.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME

# Database Settings -> SSL Configuration -> Download Certificate (prod-ca-2021.crt).
# Paste the whole public root CA PEM into Vercel's environment variable editor.
# node-postgres will verify the certificate chain and the pooler hostname.
SUPABASE_DB_CA_CERT=
